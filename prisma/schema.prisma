datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String
  password  String
  avatar    String?
  status    String   @default("Beklemede")
  isBanned  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Teacher {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String
  password  String
  branch    String
  egitim    String?
  ozgecmis  String?
  avatar    String?
  status    String   @default("Beklemede")
  isBanned  Boolean  @default(false)
  linkedin  String?
  youtube   String?
  createdAt DateTime @default(now())
}

model Feedback {
  id           Int      @id @default(autoincrement())
  studentName  String
  studentEmail String?
  teacherId    Int
  teacherName  String
  content      String
  rating       Int      @default(5)
  createdAt    DateTime @default(now())
}

model LessonOffer {
  id          Int      @id @default(autoincrement())
  title       String
  price       Float
  format      String
  description String?
  teacherId   Int
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  category    String
  authorId    Int
  authorName  String
  createdAt   DateTime @default(now())
}

model ChatRoom {
  id          Int      @id @default(autoincrement())
  studentId   Int
  studentName String
  teacherId   Int
  teacherName String
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  roomId     Int
  senderId   Int
  senderRole String   // "student" or "teacher"
  content    String
  createdAt  DateTime @default(now())
}

model TeacherFAQ {
  id        Int      @id @default(autoincrement())
  teacherId Int
  question  String
  answer    String
  createdAt DateTime @default(now())
}
