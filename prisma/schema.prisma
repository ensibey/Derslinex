datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id           Int                  @id @default(autoincrement())
  name         String
  phone        String
  email        String
  password     String
  avatar       String?
  status       String               @default("Beklemede")
  isBanned     Boolean              @default(false)
  createdAt    DateTime             @default(now())
  sessions     SessionParticipant[]
  feedbacks    SessionFeedback[]    @relation("StudentFeedback")
}

model Teacher {
  id           Int               @id @default(autoincrement())
  name         String
  phone        String
  email        String
  password     String
  branch       String
  egitim       String?
  ozgecmis     String?
  avatar       String?
  status       String            @default("Beklemede")
  isBanned     Boolean           @default(false)
  points       Int               @default(0)
  linkedin     String?
  youtube      String?
  createdAt    DateTime          @default(now())
  liveSessions LiveSession[]
  feedbacksGiven SessionFeedback[] @relation("TeacherFeedback")
  tasks        TeacherTask[]
  questions    Question[]
}

model TeacherTask {
  id          Int      @id @default(autoincrement())
  teacherId   Int
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?
  points      Int      @default(50)
  status      String   @default("PENDING") // PENDING, SUBMITTED, COMPLETED, REJECTED
  proof       String?
  createdAt   DateTime @default(now())
}

model Question {
  id               Int      @id @default(autoincrement())
  teacherId        Int
  teacher          Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject          String
  examType         String   @default("TYT")
  topic            String?
  difficulty       String   @default("Orta")
  questionText     String
  imageUrl         String?
  optionA          String
  optionB          String
  optionC          String
  optionD          String
  optionE          String
  correctOption    String
  solutionText     String?
  solutionVideoUrl String?
  points           Int      @default(20)
  status           String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED
  rejectionReason  String?
  createdAt        DateTime @default(now())

  @@index([subject, topic, difficulty])
  @@index([status])
}

model Feedback {
  id           Int      @id @default(autoincrement())
  studentName  String
  studentEmail String?
  teacherId    Int
  teacherName  String
  content      String
  rating       Int      @default(5)
  createdAt    DateTime @default(now())
}

model LessonOffer {
  id          Int      @id @default(autoincrement())
  title       String
  price       Float
  format      String
  description String?
  teacherId   Int
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  category    String
  authorId    Int
  authorName  String
  createdAt   DateTime @default(now())
}

model ChatRoom {
  id          Int      @id @default(autoincrement())
  studentId   Int
  studentName String
  teacherId   Int
  teacherName String
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  roomId     Int
  senderId   Int
  senderRole String   // "student" or "teacher"
  content    String
  createdAt  DateTime @default(now())
}

model TeacherFAQ {
  id        Int      @id @default(autoincrement())
  teacherId Int
  question  String
  answer    String
  createdAt DateTime @default(now())
}

// ─── Canlı Ders Sistemi Modelleri ─────────────────────────────────────────────

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveSession {
  id              Int                  @id @default(autoincrement())
  title           String
  description     String?
  capacity        Int                  @default(1)
  startTime       DateTime
  durationMinutes Int                  @default(60)
  // Daily.co room name (not full URL)
  roomName        String?
  // Full Daily.co room URL for iframe embedding
  roomUrl         String?
  recordSession   Boolean              @default(false)
  recordingUrl    String?
  status          SessionStatus        @default(SCHEDULED)
  teacherId       Int
  teacher         Teacher              @relation(fields: [teacherId], references: [id])
  participants    SessionParticipant[]
  resources       SessionResource[]
  feedbacks       SessionFeedback[]
  // Track whether reminder mail has already been sent
  reminderSent    Boolean              @default(false)
  createdAt       DateTime             @default(now())
}

model SessionParticipant {
  id          Int          @id @default(autoincrement())
  sessionId   Int
  session     LiveSession  @relation(fields: [sessionId], references: [id])
  studentId   Int
  student     Student      @relation(fields: [studentId], references: [id])
  joinedAt    DateTime?
  leftAt      DateTime?
  // True when student was present ≥ 50% of session duration
  isAttended  Boolean      @default(false)

  @@unique([sessionId, studentId])
}

model SessionResource {
  id        Int         @id @default(autoincrement())
  sessionId Int
  session   LiveSession @relation(fields: [sessionId], references: [id])
  title     String
  fileUrl   String
  createdAt DateTime    @default(now())
}

model SessionFeedback {
  id            Int         @id @default(autoincrement())
  sessionId     Int
  session       LiveSession @relation(fields: [sessionId], references: [id])
  teacherId     Int
  teacher       Teacher     @relation("TeacherFeedback", fields: [teacherId], references: [id])
  studentId     Int
  student       Student     @relation("StudentFeedback", fields: [studentId], references: [id])
  rating        Int         // 1 – 5
  comment       String?
  homeworkGiven Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([sessionId, studentId])
}

