datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id              Int                  @id @default(autoincrement())
  name            String
  phone           String
  email           String
  password        String
  avatar          String?
  targetTag       String?              @default("TYT")
  status          String               @default("Beklemede")
  isEmailVerified Boolean              @default(false)
  isBanned        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  sessions        SessionParticipant[]
  feedbacks       SessionFeedback[]    @relation("StudentFeedback")
  quizResults     StudentQuizResult[]
  attempts        StudentQuestionAttempt[]
  examAttempts    StudentExamAttempt[]
  trialResults    StudentTrialResult[]
  topicProgress   StudentTopicProgress[]
}

model Teacher {
  id              Int               @id @default(autoincrement())
  name            String
  phone           String
  email           String
  password        String
  branch          String
  egitim          String?
  ozgecmis        String?
  avatar          String?
  status          String            @default("Beklemede")
  isEmailVerified Boolean           @default(false)
  isBanned        Boolean           @default(false)
  points          Int               @default(0)
  linkedin        String?
  youtube         String?
  createdAt       DateTime          @default(now())
  liveSessions    LiveSession[]
  feedbacksGiven  SessionFeedback[] @relation("TeacherFeedback")
  tasks           TeacherTask[]
  questions       Question[]
  studentFeedbacks Feedback[]
  lessonOffers    LessonOffer[]
  faqs            TeacherFAQ[]
}

model TeacherTask {
  id          Int      @id @default(autoincrement())
  teacherId   Int
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?
  points      Int      @default(50)
  status      String   @default("PENDING") // PENDING, SUBMITTED, COMPLETED, REJECTED
  proof       String?
  createdAt   DateTime @default(now())
}

model Question {
  id               Int      @id @default(autoincrement())
  teacherId        Int
  teacher          Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject          String
  examType         String   @default("TYT")
  topic            String?
  difficulty       String   @default("Orta")
  questionText     String
  imageUrl         String?
  optionA          String
  optionB          String
  optionC          String
  optionD          String
  optionE          String
  correctOption    String
  solutionText     String?
  solutionVideoUrl String?
  points           Int      @default(20)
  status           String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED
  rejectionReason  String?
  createdAt        DateTime @default(now())
  attempts         StudentQuestionAttempt[]
  examQuestions    ExamQuestion[]

  @@index([subject, topic, difficulty])
  @@index([status])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  token     String   @unique
  role      String   @default("student")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([code])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  role      String   @default("student")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Feedback {
  id           Int      @id @default(autoincrement())
  studentName  String
  studentEmail String?
  teacherId    Int
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherName  String
  content      String
  rating       Int      @default(5)
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now())

  @@index([teacherId])
  @@index([status])
}

model LessonOffer {
  id          Int      @id @default(autoincrement())
  title       String
  price       Float
  format      String
  description String?
  teacherId   Int
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([teacherId])
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  category    String
  authorId    Int
  authorName  String
  createdAt   DateTime @default(now())
}

model ChatRoom {
  id          Int           @id @default(autoincrement())
  studentId   Int
  studentName String
  teacherId   Int
  teacherName String
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  roomId     Int
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   Int
  senderRole String   // "student" or "teacher"
  content    String
  createdAt  DateTime @default(now())

  @@index([roomId])
}

model TeacherFAQ {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())

  @@index([teacherId])
}

// ─── Canlı Ders Sistemi Modelleri ─────────────────────────────────────────────

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveSession {
  id              Int                  @id @default(autoincrement())
  title           String
  description     String?
  capacity        Int                  @default(1)
  startTime       DateTime
  durationMinutes Int                  @default(60)
  // Daily.co room name (not full URL)
  roomName        String?
  // Full Daily.co room URL for iframe embedding
  roomUrl         String?
  recordSession   Boolean              @default(false)
  recordingUrl    String?
  status          SessionStatus        @default(SCHEDULED)
  teacherId       Int
  teacher         Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  participants    SessionParticipant[]
  resources       SessionResource[]
  feedbacks       SessionFeedback[]
  // Track whether reminder mail has already been sent
  reminderSent    Boolean              @default(false)
  createdAt       DateTime             @default(now())
}

model SessionParticipant {
  id          Int          @id @default(autoincrement())
  sessionId   Int
  session     LiveSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt    DateTime?
  leftAt      DateTime?
  // True when student was present ≥ 50% of session duration
  isAttended  Boolean      @default(false)

  @@unique([sessionId, studentId])
}

model SessionResource {
  id        Int         @id @default(autoincrement())
  sessionId Int
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  createdAt DateTime    @default(now())
}

model SessionFeedback {
  id            Int         @id @default(autoincrement())
  sessionId     Int
  session       LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teacherId     Int
  teacher       Teacher     @relation("TeacherFeedback", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId     Int
  student       Student     @relation("StudentFeedback", fields: [studentId], references: [id], onDelete: Cascade)
  rating        Int         // 1 – 5
  comment       String?
  homeworkGiven Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([sessionId, studentId])
}

model StudentQuizResult {
  id             Int                      @id @default(autoincrement())
  studentId      Int
  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examType       String                   @default("TYT")
  subject        String
  totalQuestions Int
  correctCount   Int
  wrongCount     Int
  emptyCount     Int
  netScore       Float
  totalPoints    Int
  createdAt      DateTime                 @default(now())
  attempts       StudentQuestionAttempt[]

  @@index([studentId])
}

model StudentQuestionAttempt {
  id             Int               @id @default(autoincrement())
  quizResultId   Int
  quizResult     StudentQuizResult @relation(fields: [quizResultId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId     Int
  question       Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String
  isCorrect      Boolean
  createdAt      DateTime          @default(now())

  @@index([studentId, questionId])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED
  createdAt DateTime @default(now())
}

model StudentTrialResult {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title        String
  examType     String   @default("TYT")
  turkceNet    Float    @default(0)
  sosyalNet    Float    @default(0)
  matematikNet Float    @default(0)
  fenNet       Float    @default(0)
  toplamNet    Float    @default(0)
  date         DateTime @default(now())

  @@index([studentId])
}

model StudentTopicProgress {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     String
  topic       String
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([studentId, subject, topic])
  @@index([studentId])
}

// ─── ONLINE DENEME SINAVI & KAMERA GÖZETMENLİK MODELLERİ ───────────────────────
model Exam {
  id               Int                  @id @default(autoincrement())
  title            String
  description      String?
  examType         String               @default("TYT") // "TYT", "AYT", "LGS", "YKS", "KPSS"
  targetTag        String               @default("TÜMÜ") // "TÜMÜ", "TYT", "AYT", "LGS", "KPSS"
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int                  @default(135)
  status           String               @default("DRAFT") // "DRAFT", "PUBLISHED", "ACTIVE", "ENDED"
  isCameraRequired Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  examQuestions    ExamQuestion[]
  attempts         StudentExamAttempt[]
}

model ExamQuestion {
  id           Int      @id @default(autoincrement())
  examId       Int
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId   Int
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderNo      Int      @default(1)
  sectionName  String   @default("Genel") // "Türkçe", "Sosyal Bilgiler", "Temel Matematik", "Fen Bilimleri"
  customPoints Float?

  @@index([examId])
  @@index([questionId])
}

model StudentExamAttempt {
  id             Int                 @id @default(autoincrement())
  examId         Int
  exam           Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  proctorRoomUrl String?             // Daily.co proctor room URL for live camera stream
  hasCamera      Boolean             @default(false)
  focusWarnings  Int                 @default(0) // Number of tab switches (focus loss)
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  turkceNet      Float               @default(0)
  sosyalNet      Float               @default(0)
  matematikNet   Float               @default(0)
  fenNet         Float               @default(0)
  totalNet       Float               @default(0)
  totalScore     Float               @default(0)
  status         String              @default("IN_PROGRESS") // "IN_PROGRESS", "SUBMITTED", "TIMED_OUT"
  answers        StudentExamAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId, status])
}

model StudentExamAnswer {
  id             Int                @id @default(autoincrement())
  attemptId      Int
  attempt        StudentExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     Int
  selectedOption String?            // "A", "B", "C", "D", "E" or null
  isFlagged      Boolean            @default(false)
  isCorrect      Boolean?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([attemptId, questionId])
}



